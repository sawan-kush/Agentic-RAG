# Copy this file to `.env` (same folder as docker-compose.yml) and fill it in:
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
# Keep comments on their own lines (not after a value). Never commit .env.

# ---------- Backend (same keys as backend/.env.example) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile
PINECONE_API_KEY=
# The Pinecone index name (dimension 1536, metric cosine). Create it once with: docker compose run --rm backend python create_index.py
PINECONE_INDEX=
# Origin of the web app, used for CORS. Must match the address you open in the browser.
FRONTEND_URL=http://localhost:3000

# ---------- Frontend (baked into the browser bundle when the image is BUILT) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The address the BROWSER uses to reach the backend. Change it (and rebuild) when you deploy to a server.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Redis cache (all optional; the values shown are the defaults) ----------
# Memory cap for the Redis container. When it is full, the least recently used cache entries are dropped.
REDIS_MAXMEMORY=256mb
# How long cached things live, in seconds:
# EMBED_CACHE_TTL=2592000   # embeddings (30 days)
# ANSWER_CACHE_TTL=3600     # full chat answers (1 hour)
# LLM_CACHE_TTL=3600        # router / query-rewrite / verifier results (1 hour)
# AUTH_CACHE_TTL=60         # remember a verified login token this long (0 = always ask Supabase)