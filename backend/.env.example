# To use it without Docker for the backend:  docker compose up -d redis   then:
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=
# Optional, in seconds (defaults shown):
# EMBED_CACHE_TTL=2592000
# ANSWER_CACHE_TTL=3600
# LLM_CACHE_TTL=3600
# AUTH_CACHE_TTL=60
